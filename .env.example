# Настройки сайта. Скопируй в .env и заполни: cp .env.example .env
# .env не попадает в git. Значение с пробелами или «#» возьми в кавычки: DB_PASS="pa ss#1"

# База MySQL / MariaDB — из панели хостинга
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=
DB_PREFIX=kurs_

# Адрес сайта без пути и слэша в конце: нужен для ссылок в письмах
APP_URL=https://aiblocks.ru

# 1 — показывать текст ошибки на странице. Только на время настройки
APP_DEBUG=0

# Для первого ./deploy.sh --seed. Пароль пустой — сгенерируется и покажется один раз.
# После создания администратора эти строки можно удалить
ADMIN_EMAIL=
ADMIN_NAME=Администратор
ADMIN_PASSWORD=
SITE_NAME=AIblocks
MAIL_FROM=
